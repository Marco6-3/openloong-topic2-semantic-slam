# direnv 每次进入仓库时都从已提交的锁文件激活环境。
if ! has pixi; then
  log_error "未找到 pixi，请先安装 Pixi。"
  return 1
fi

watch_file pixi.toml
watch_file pixi.lock

if [[ ! -f pixi.lock ]]; then
  log_error "缺少 pixi.lock，请先执行 pixi install。"
  return 1
fi

# --locked 会在 pixi.toml 与 pixi.lock 不一致时直接失败，不会悄悄改锁文件。
eval "$(pixi shell-hook --shell bash --locked)"
